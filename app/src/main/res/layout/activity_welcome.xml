<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background"
    tools:context=".WelcomeActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="@dimen/spacing_l">

        <!-- Top Header Illustration / Icon -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardWelcomeIcon"
            style="@style/Widget.Relief.CardView"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_marginTop="@dimen/spacing_xl"
            app:cardCornerRadius="44dp"
            app:cardElevation="6dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/logo_content_desc"
                android:padding="@dimen/spacing_m"
                android:src="@drawable/location_icon"
                app:tint="@color/primary" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Welcome Headline -->
        <TextView
            android:id="@+id/tvWelcomeTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_l"
            android:gravity="center"
            android:text="Welcome to Relief Distribution"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_display"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardWelcomeIcon" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tvWelcomeSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:gravity="center"
            android:text="Real-time disaster relief routing, emergency hotlines, and humanitarian aid coordination."
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_size_body"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvWelcomeTitle" />

        <!-- Value Proposition Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardHighlights"
            style="@style/Widget.Relief.CardView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            android:layout_marginBottom="@dimen/spacing_xl"
            app:layout_constraintBottom_toTopOf="@id/btLogin"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvWelcomeSubtitle"
            app:layout_constraintVertical_bias="0.3">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_m">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Live GPS location telemetry for field distributors"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_body"
                    android:layout_marginBottom="@dimen/spacing_xs" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• One-touch 999 emergency hotline connection"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_body"
                    android:layout_marginBottom="@dimen/spacing_xs" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Offline-first disaster preparedness advisories"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_body" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Login Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btLogin"
            style="@style/Widget.Relief.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_marginBottom="@dimen/spacing_m"
            android:text="Sign In"
            android:textSize="@dimen/text_size_title"
            app:layout_constraintBottom_toTopOf="@id/btRegister"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Register Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btRegister"
            style="@style/Widget.Relief.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_marginBottom="@dimen/spacing_l"
            android:text="Create Account"
            android:textSize="@dimen/text_size_title"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
