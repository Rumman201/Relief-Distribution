<?xml version="1.0" encoding="utf-8"?>
<!--
   Relief Distribution System - Data Extraction Rules (Android 12+, API 31+)
   Enforces zero-trust storage isolation: Excludes session identifiers,
   auth tokens, and local cached data from cloud backups and device-to-device transfers.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude all shared preferences to prevent cloud extraction of user sessions -->
        <exclude domain="sharedpref" path="." />
        <exclude domain="root" path="databases" />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- Exclude shared preferences and cached databases during device migration -->
        <exclude domain="sharedpref" path="." />
        <exclude domain="root" path="databases" />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
