<?xml version="1.0" encoding="utf-8"?>
<!--
   Relief Distribution System - Backup Security Rules (Android 11 and below)
   Prevents unauthorized extraction of cached credentials, user identifiers,
   and local session data via ADB or auto-backup.
-->
<full-backup-content>
    <!-- Exclude all shared preferences containing session or user identity data -->
    <exclude domain="sharedpref" path="." />
    <!-- Exclude local cache directories -->
    <exclude domain="root" path="databases" />
    <exclude domain="file" path="." />
</full-backup-content>
